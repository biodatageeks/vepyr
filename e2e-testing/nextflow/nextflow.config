// HG002 annotation through the nf-core vepyr/annotate module.
// See e2e-testing/README.md ("nextflow/").

params {
    release      = '116'
    profile      = 'merged'    // merged | ensembl | refseq | merged_plugins | merged_phenotypeorthologous
    chroms       = 'all'       // 'all' (chr1-chr22) or e.g. 'chr21,chr22'
    compare      = true        // body md5 against the Ensembl VEP reference

    // Same workspace as scripts/run_comparison.py.
    data_dir     = System.getenv('DATA_VEPYR_DIR') ?: "${System.getProperty('user.home')}/workspace/data_vepyr"
    // Explicit paths; null derives them from data_dir x release x profile.
    vcf          = null        // results/<release>/_shared/normalized.vcf.gz, else $data_dir/input/HG002_normalized.vcf.gz
    fasta        = null        // $data_dir/input/Homo_sapiens.GRCh38.dna.primary_assembly.fa
    cache        = null        // $data_dir/cache/<release>_GRCh38_<profile>
    vep          = null        // $data_dir/output/<release dir>/<profile reference>, per contig for plugin profiles
    plugin_cache = null        // plugin profiles: $data_dir/cache/plugin_cache_<release>, else $data_dir/plugin_cache_<release>

    outdir       = "${projectDir.parent}/results"
    workers      = 4           // --fork per contig
    max_parallel = 2           // contigs annotated at once
}

docker.enabled = true
// The module's own Wave images, one per architecture: an arm64 host (Apple
// Silicon) must never run the amd64 image under emulation -- SIGILL, no AVX.
docker.runOptions = '-u $(id -u):$(id -g) --platform=' + ((System.getProperty('os.arch') in ['aarch64', 'arm64']) ? 'linux/arm64' : 'linux/amd64')

process {
    // Keep in sync with containers.docker in
    // nf-core-module/modules/nf-core/vepyr/annotate/meta.yml. SLICE_CONTIG and
    // COMPARE_MD5 use it too, for tabix and bgzip.
    container = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
        ? 'community.wave.seqera.io/library/htslib_pip_python_vepyr:d7cf9a888587f5b0'
        : 'community.wave.seqera.io/library/htslib_pip_python_vepyr:00a5ec7681bdfa20'

    withName: 'VEPYR_ANNOTATE' {
        container  = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
            ? 'community.wave.seqera.io/library/htslib_pip_python_vepyr:d7cf9a888587f5b0'
            : 'community.wave.seqera.io/library/htslib_pip_python_vepyr:00a5ec7681bdfa20'
        // Plugin profiles pass their plugins in reference CSQ order (meta.plugins).
        ext.args   = { (['--everything'] + (meta.plugins ?: []).collect { name -> "--plugin ${name}" }).join(' ') }
        ext.prefix = { "vepyr_parquet_${meta.id}_${params.profile}" }
        cpus       = params.workers
        maxForks   = params.max_parallel
        publishDir = [
            path: { "${params.outdir}/${params.release}/nextflow_${params.profile}" },
            mode: 'copy',
        ]
    }
}
