// Native linux/arm64 run of the module tests on Apple Silicon, using the
// local image from dev/Dockerfile. Not part of the nf-core submission.
includeConfig '../tests/config/nf-test.config'

// The fixture is not on nf-core/test-datasets yet: point this at the data/
// directory produced by ../stage-testdata.sh (trailing slash required).
params.modules_testdata_base_path = System.getenv('VEPYR_NF_TESTDATA') ?: params.modules_testdata_base_path

// Offline HG002 chr22 VEP parity fixture (tests/data/hg002_chr22).
params.hg002_chr22 = System.getenv('VEPYR_HG002_CHR22')

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/arm64'
// Otherwise the unqualified local image name is rewritten to quay.io/vepyr-dev.
docker.registry   = ''

process {
    withName: 'VEPYR_ANNOTATE' {
        container = System.getenv('VEPYR_DEV_IMAGE') ?: 'vepyr-dev:0.7.0-arm64'
    }
    // The pinned Seqera image for UNTAR is linux/amd64 only.
    withName: 'UNTAR' {
        container = 'ubuntu:24.04'
    }
}
