// Native run of the module tests with the module's own Wave containers, on
// Linux (x86_64 or aarch64) or Apple Silicon. Driven by dev/nf-test-local.sh,
// which sets the environment variables below. Not part of the nf-core submission.
includeConfig '../tests/config/nf-test.config'

// The golden fixture is not on nf-core/test-datasets yet: point this at the
// data/ directory produced by ../stage-testdata.sh (trailing slash required).
params.modules_testdata_base_path = System.getenv('VEPYR_NF_TESTDATA') ?: params.modules_testdata_base_path

// Offline HG002 chr22 VEP parity fixture (tests/data/hg002_chr22).
params.hg002_chr22 = System.getenv('VEPYR_HG002_CHR22')

// main.nf names only the linux/amd64 image, so the host's image from meta.yml
// is set explicitly: never run the amd64 image under emulation on Apple Silicon,
// it dies with SIGILL (no AVX).
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g) --platform=' + (System.getenv('VEPYR_DOCKER_PLATFORM') ?: 'linux/arm64')

process {
    withName: 'VEPYR_ANNOTATE' {
        container = System.getenv('VEPYR_CONTAINER')
    }
    // The pinned Seqera image for UNTAR is linux/amd64 only. Fully qualified:
    // tests/config/nf-test.config sets docker.registry = 'quay.io', which is
    // prepended to any image name without a registry.
    withName: 'UNTAR' {
        container = 'docker.io/library/ubuntu:24.04'
    }
}
