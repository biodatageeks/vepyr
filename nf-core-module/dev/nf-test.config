config {
    testsDir "modules"
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "dev/arm64.config"
    profile ""

    // Same pins as nf-core/modules' root nf-test.config; nft-vcf provides
    // path(...).vcf.variantsMD5 used by the snapshot.
    plugins {
        load "nft-vcf@1.0.7"
        load "nft-utils@1.2.0"
    }
}
