process {
    // No ext.prefix: BCFTOOLS_NORM writes ${meta.id}.vcf.gz, the name
    // VEPYR_ANNOTATE also writes, which the module's input staging must absorb.
    withName: 'BCFTOOLS_NORM' {
        ext.args = '--multiallelics -both --do-not-normalize --output-type z --write-index=tbi'
    }
    withName: 'VEPYR_ANNOTATE' {
        ext.args = '--everything'
    }
}
