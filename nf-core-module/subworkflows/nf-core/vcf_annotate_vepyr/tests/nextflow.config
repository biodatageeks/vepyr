params {
    bcftools_norm_args = '--multiallelics -both --do-not-normalize --output-type z --write-index=tbi'
    hf_download_args = "--revision 02d7acf270f8ae63e3bfeca01f210923cc5192cf --include '*/chr22.parquet' --include '*/chrom_manifest.json'"
}

process {
    withName: 'BCFTOOLS_NORM' {
        ext.args = { params.bcftools_norm_args }
    }
    withName: 'BCFTOOLS_JOIN_MULTIALLELICS' {
        ext.args = '--multiallelics +both --do-not-normalize --output-type z'
    }
    withName: 'HUGGINGFACE_DOWNLOAD' {
        ext.args = { params.hf_download_args }
    }
}
