process {
    // No ext.prefix: BCFTOOLS_NORM writes ${meta.id}.vcf.gz, which the
    // VEPYR_ANNOTATE default prefix, ${meta.id}_vepyr, never collides with.
    withName: 'BCFTOOLS_NORM' {
        ext.args = '--multiallelics -both --do-not-normalize --output-type z --write-index=tbi'
    }
    withName: 'VEPYR_ANNOTATE' {
        ext.args = '--everything'
    }
}
