nextflow_process {

    name "Test Process VEPYR_ANNOTATE"
    script "../main.nf"
    process "VEPYR_ANNOTATE"

    tag "modules"
    tag "modules_nfcore"
    tag "untar"
    tag "vepyr"
    tag "vepyr/annotate"

    test("homo_sapiens - vcf") {
        config "./nextflow.config"

        setup {
            run("HUGGINGFACE_DOWNLOAD") {
                script "modules/nf-core/huggingface/download/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'116_GRCh38_ensembl' ],
                        'datasets/biodatageeks/vepyr_116_GRCh38_ensembl',
                        []
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = HUGGINGFACE_DOWNLOAD.out.output.collect()
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"], unstableKeys: ["tbi"])).match() }
            )
        }
    }

    test("homo_sapiens - vcf - no index") {
        config "./nextflow.config"

        setup {
            run("HUGGINGFACE_DOWNLOAD") {
                script "modules/nf-core/huggingface/download/main.nf"
                process {
                    """
                    input[0] = channel.of([
                        [ id:'116_GRCh38_ensembl' ],
                        'datasets/biodatageeks/vepyr_116_GRCh38_ensembl',
                        []
                    ])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = HUGGINGFACE_DOWNLOAD.out.output.collect()
                input[2] = channel.value([
                    [ id:'GRCh38' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.fai', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/reference.fa.gz.gzi', checkIfExists: true)
                ])
                input[3] = 116
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out, variantsMD5Keys: ["vcf"], unstableKeys: ["tbi"])).match() }
            )
        }
    }

    test("homo_sapiens - vcf - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = channel.value([[ id:'cache' ], []])
                input[2] = channel.value([[ id:'GRCh38' ], [], [], []])
                input[3] = []
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("homo_sapiens - vcf - no fasta - fails") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/vepyr/input.vcf.gz', checkIfExists: true),
                    []
                ])
                input[1] = channel.value([[ id:'cache' ], []])
                input[2] = channel.value([[ id:'GRCh38' ], [], [], []])
                input[3] = []
                input[4] = [[], []]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.stdout.any { it.contains("VEPYR_ANNOTATE requires a reference FASTA") } }
            )
        }
    }
}
